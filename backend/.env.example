# Server
PORT=5060
NODE_ENV=development

# Auth
JWT_SECRET=replace-me-with-a-long-random-string

# Postgres — production: use DATABASE_URL from your host (Railway/Render/Neon/etc.)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Postgres (local fallback, used when DATABASE_URL is unset)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orr
DB_USER=orr
DB_PASS=orr

# One-time demo seed: set to 1 on the very first deploy, then unset.
# SEED_DEMO=1

# Optional: AWS / S3 (for invoice PDF storage). Leave blank to store on local disk.
AWS_REGION=us-east-1
S3_INVOICE_BUCKET=

# Optional: SMTP (for invoice emails). Leave blank to skip email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ORR Billing <billing@orr.local>"

# Frontend origin (CORS)
FRONTEND_ORIGIN=http://localhost:9100
